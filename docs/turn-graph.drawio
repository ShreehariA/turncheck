<mxfile host="app.diagrams.net">
  <diagram name="Turn graph" id="turn-graph">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="5" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="830" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="turn" value="&lt;b&gt;Candidate&amp;#x27;s turn&lt;/b&gt;" style="rounded=1;arcSize=50;fillColor=#FFFFFF;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Helvetica;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="335" y="8" width="160" height="38" as="geometry" />
        </mxCell>
        <mxCell id="read" value="&lt;b&gt;Read it twice&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;model label + wording rules&lt;/font&gt;" style="rounded=0;fillColor=#FFFFFF;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Helvetica;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="305" y="70" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="agree" value="&lt;b&gt;Do the two&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;readings agree?&lt;/font&gt;" style="rhombus;fillColor=#FFFFFF;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Helvetica;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="300" y="144" width="230" height="86" as="geometry" />
        </mxCell>
        <mxCell id="ask" value="&lt;b&gt;Ask the candidate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;answer, question&lt;br&gt;or still thinking?&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:12px&quot;&gt;assist: the candidate decides&lt;/i&gt;" style="rounded=0;fillColor=#FFFFFF;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Helvetica;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="600" y="150" width="200" height="74" as="geometry" />
        </mxCell>
        <mxCell id="fix" value="&lt;b&gt;One-tap correction&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;of the last reading,&lt;br&gt;until the next turn&lt;/font&gt;" style="rounded=1;arcSize=50;fillColor=#FFFFFF;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Helvetica;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="30" y="258" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="as" value="&lt;b&gt;Read as?&lt;/b&gt;" style="rhombus;fillColor=#FFFFFF;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Helvetica;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="350" y="258" width="130" height="70" as="geometry" />
        </mxCell>
        <mxCell id="wait" value="&lt;b&gt;Wait&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;say nothing, keep the words&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:12px&quot;&gt;no action, and it is shown&lt;/i&gt;" style="rounded=0;fillColor=#FFFFFF;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Helvetica;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="30" y="380" width="200" height="66" as="geometry" />
        </mxCell>
        <mxCell id="pick" value="&lt;b&gt;Pick a sheet entry&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;model names an id,&lt;br&gt;code checks the sheet&lt;/font&gt;" style="rounded=0;fillColor=#FFFFFF;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Helvetica;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="315" y="380" width="200" height="66" as="geometry" />
        </mxCell>
        <mxCell id="record" value="&lt;b&gt;Record the answer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;undo until the next turn&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:12px&quot;&gt;execute and report&lt;/i&gt;" style="rounded=0;fillColor=#FFFFFF;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Helvetica;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="600" y="380" width="200" height="66" as="geometry" />
        </mxCell>
        <mxCell id="stuck" value="&lt;b&gt;Ask what next&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;keep thinking, repeat&lt;br&gt;or move on?&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:12px&quot;&gt;assist: the candidate decides&lt;/i&gt;" style="rounded=0;fillColor=#FFFFFF;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Helvetica;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="30" y="486" width="200" height="74" as="geometry" />
        </mxCell>
        <mxCell id="say" value="&lt;b&gt;Say the entry&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;fixed text, logged&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:12px&quot;&gt;execute and report&lt;/i&gt;" style="rounded=0;fillColor=#FFFFFF;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Helvetica;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="250" y="486" width="155" height="74" as="geometry" />
        </mxCell>
        <mxCell id="decline" value="&lt;b&gt;Decline, say why&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;no hint is given&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:12px&quot;&gt;execute and report&lt;/i&gt;" style="rounded=0;fillColor=#FFFFFF;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Helvetica;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="425" y="486" width="155" height="74" as="geometry" />
        </mxCell>
        <mxCell id="next" value="&lt;b&gt;Next question&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;or, after the last one,&lt;br&gt;the record for a person&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:12px&quot;&gt;advise: the person scores&lt;/i&gt;" style="rounded=0;fillColor=#FFFFFF;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Helvetica;fontSize=15;" vertex="1" parent="1">
